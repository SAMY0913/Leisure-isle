static var _frames: Array = []

static func _ensure() -> void:
	if not _frames.is_empty():
		return
	for f in FRAMES:
		var out: Dictionary = {"t": float(f["t"])}
		for k in COLOR_KEYS:
			out[k] = Color(String(f[k]))
		for k in NUMBER_KEYS:
			out[k] = float(f[k])
		_frames.append(out)

static func sample(t: float) -> Dictionary:
	_ensure()
	t = fposmod(t, 1.0)
	var n: int = _frames.size()
	var i: int = 0
	while i < n - 2 and t >= float(_frames[i + 1]["t"]):
		i += 1
	var a: Dictionary = _frames[i]
	var b: Dictionary = _frames[i + 1]
	var span: float = maxf(0.000001, float(b["t"]) - float(a["t"]))
	var u: float = clampf((t - float(a["t"])) / span, 0.0, 1.0)
	var res: Dictionary = {}
	for k in COLOR_KEYS:
		res[k] = (a[k] as Color).lerp(b[k], u)
	for k in NUMBER_KEYS:
		res[k] = lerpf(a[k], b[k], u)
	res["t"] = t
	return res
